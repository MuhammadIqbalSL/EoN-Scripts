-- 2. UTILITIES & TWEEN ENGINE
--====================================================
local Utils = {}

function Utils.Create(className, properties, children)
    local inst = Instance.new(className)
    for k, v in pairs(properties or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    for _, child in pairs(children or {}) do child.Parent = inst end
    if properties and properties.Parent then inst.Parent = properties.Parent end
    return inst
end

function Utils.GetTweenDuration()
    if SettingsState.BoostFpsMode then return 0.02 end
    if SettingsState.AnimationSpeed == "Fast" then return 0.1
    elseif SettingsState.AnimationSpeed == "Slow" then return 0.4
    else return 0.22 end -- Normal
end

function Utils.Tween(obj, props, customDuration)
    local duration = customDuration or Utils.GetTweenDuration()
    local info = TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local tween = TweenService:Create(obj, info, props)
    tween:Play()
    table.insert(AppState.ActiveTweens, tween)
    return tween
end

function Utils.FormatTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

function Utils.ApplyHover(button, baseSize, scaleMult, baseColor, hoverColor)
    button.MouseEnter:Connect(function()
        if SettingsState.BoostFpsMode then return end
        Utils.Tween(button, {
            Size = UDim2.new(baseSize.X.Scale, baseSize.X.Offset * scaleMult, baseSize.Y.Scale, baseSize.Y.Offset * scaleMult),
            BackgroundColor3 = hoverColor or button.BackgroundColor3
        })
    end)
    button.MouseLeave:Connect(function()
        Utils.Tween(button, {
            Size = baseSize,
            BackgroundColor3 = baseColor or button.BackgroundColor3
        })
    end)
end

function Utils.EnableDrag(dragArea, targetFrame, isFloating)
    local dragging = false
    local dragInput, dragStart, startPos
    local hasMoved = false

    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
            hasMoved = false
            
            local c
            c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    c:Disconnect()
                end
            end)
        end
    end)

    dragArea.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    local changedConn = UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            if delta.Magnitude > Config.DragThreshold then
                hasMoved = true
            end
            if not isFloating or (isFloating and hasMoved) then
                local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                targetFrame.Position = newPos
                if isFloating then AppState.FloatPosition = newPos end
            end
        end
    end)
    table.insert(AppState.Connections, changedConn)
    
    if isFloating then
        dragArea.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if not hasMoved then _G.RestoreMainWindow() end
            end
        end)
    end
end

