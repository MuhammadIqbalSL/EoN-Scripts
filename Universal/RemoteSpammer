local Utils = {}

function Utils.Create(className, properties, children)
    local inst = Instance.new(className)
    for k, v in pairs(properties or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    for _, child in pairs(children or {}) do
        child.Parent = inst
    end
    if properties and properties.Parent then inst.Parent = properties.Parent end
    
    -- Registrasi otomatis untuk dynamic styling
    if inst:IsA("UIStroke") then
        table.insert(DynamicElements.Borders, inst)
    elseif inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
        table.insert(DynamicElements.Texts, {
            Object = inst,
            BaseSize = inst.TextSize
        })
    end

    return inst
end

function Utils.Tween(obj, props, duration)
    duration = duration or Config.AnimationSpeed
    local tween = TweenService:Create(obj, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

function Utils.FormatTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

function Utils.EnableDrag(dragArea, targetFrame, isFloating)
    local dragging = false
    local dragInput
    local dragStart
    local startPos
    local hasMoved = false

    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
            hasMoved = false

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragArea.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            if delta.Magnitude > Config.DragThreshold then
                hasMoved = true
            end
            
            if not isFloating or (isFloating and hasMoved) then
                targetFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end)
    
    if isFloating then
        dragArea.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if not hasMoved then
                    _G.RestoreMainWindow()
                end
            end
        end)
    end
end

