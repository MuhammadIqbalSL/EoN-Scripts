local Notification = {}
function Notification.Notify(title, desc, notifType)
    local col = Theme.Accent
    if notifType == "Success" then col = Theme.Success
    elseif notifType == "Warning" then col = Theme.Warning end

    local toast = Utils.Create("Frame", { Parent = NotifContainer, BackgroundColor3 = Theme.Panel, Size = UDim2.new(1, 0, 0, 55), BackgroundTransparency = 1 }, {
        Utils.Create("UICorner", { CornerRadius = UDim.new(0, 6) }), Utils.Create("UIStroke", { Color = col, Thickness = 1.5 }),
        Utils.Create("TextLabel", { Name = "T", BackgroundTransparency = 1, Size = UDim2.new(1, -15, 0, 22), Position = UDim2.new(0, 12, 0, 5), Text = title, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = col, TextTransparency = 1 }),
        Utils.Create("TextLabel", { Name = "D", BackgroundTransparency = 1, Size = UDim2.new(1, -15, 0, 22), Position = UDim2.new(0, 12, 0, 25), Text = desc, Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = Theme.Text, TextWrapped = true, TextTransparency = 1 })
    })
    Utils.Tween(toast, { BackgroundTransparency = 0 }, 0.2)
    Utils.Tween(toast.T, { TextTransparency = 0 }, 0.2)
    Utils.Tween(toast.D, { TextTransparency = 0 }, 0.2)

    task.delay(3, function()
        if not toast or not toast.Parent then return end
        Utils.Tween(toast, { BackgroundTransparency = 1 }, 0.2)
        Utils.Tween(toast.T, { TextTransparency = 1 }, 0.2)
        Utils.Tween(toast.D, { TextTransparency = 1 }, 0.2)
        task.wait(0.2) toast:Destroy()
    end)
end

