function Components.CreateSlider(parent, labelText, valuesList, defaultValue, callback)
    local sliderFrame = Utils.Create("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = parent })
    local lbl = Utils.Create("TextLabel", { Parent = sliderFrame, BackgroundTransparency = 1, Size = UDim2.new(0.4, 0, 0, 20), Text = labelText, Font = Enum.Font.GothamSemibold, TextSize = 12, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left })
    local valLbl = Utils.Create("TextLabel", { Parent = sliderFrame, BackgroundTransparency = 1, Size = UDim2.new(0.2, 0, 0, 20), Position = UDim2.new(0.8, 0, 0, 0), Text = tostring(defaultValue), Font = Enum.Font.Code, TextSize = 12, TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right })
    
    local track = Utils.Create("Frame", { Parent = sliderFrame, BackgroundColor3 = Theme.Background, Size = UDim2.new(0.75, 0, 0, 6), Position = UDim2.new(0, 0, 0, 26) }, {
        Utils.Create("UICorner", { CornerRadius = UDim.new(1, 0) }), Utils.Create("UIStroke", { Color = Theme.Border, Thickness = 1 })
    })
    local fill = Utils.Create("Frame", { Parent = track, BackgroundColor3 = Theme.Accent, Size = UDim2.new(0, 0, 1, 0) }, { Utils.Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    local thumb = Utils.Create("TextButton", { Parent = track, BackgroundColor3 = Theme.Text, Size = UDim2.new(0, 12, 0, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Text = "" }, {
        Utils.Create("UICorner", { CornerRadius = UDim.new(1, 0) }), Utils.Create("UIStroke", { Name = "Glow", Color = Theme.AccentGlow, Thickness = 1.5, Enabled = false })
    })

    local activeIdx = 1
    for i, v in ipairs(valuesList) do if v == defaultValue then activeIdx = i break end end

    local function updateToPosition(percentage)
        percentage = math.clamp(percentage, 0, 1)
        local idx = math.round(percentage * (#valuesList - 1)) + 1
        activeIdx = idx
        valLbl.Text = tostring(valuesList[idx])
        
        local targetPercent = (#valuesList > 1) and ((idx - 1) / (#valuesList - 1)) or 0
        Utils.Tween(fill, { Size = UDim2.new(targetPercent, 0, 1, 0) }, 0.1)
        Utils.Tween(thumb, { Position = UDim2.new(targetPercent, 0, 0.5, 0) }, 0.1)
        
        callback(valuesList[idx])
    end

    updateToPosition((activeIdx - 1) / (#valuesList - 1))

    thumb.MouseEnter:Connect(function()
        if SettingsState.BoostFpsMode then return end
        Utils.Tween(thumb, { Size = UDim2.new(0, 15, 0, 15), BackgroundColor3 = Theme.AccentGlow })
        thumb.Glow.Enabled = true
    end)
    thumb.MouseLeave:Connect(function()
        Utils.Tween(thumb, { Size = UDim2.new(0, 12, 0, 12), BackgroundColor3 = Theme.Text })
        thumb.Glow.Enabled = false
    end)

    local dragging = false
    thumb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local trackAbsPos = track.AbsolutePosition.X
            local trackAbsSize = track.AbsoluteSize.X
            local mouseX = input.Position.X
            updateToPosition((mouseX - trackAbsPos) / trackAbsSize)
        end
    end)

    local ext = {}
    function ext:SetDisabled(status)
        thumb.Visible = not status
        track.BackgroundTransparency = status and 0.7 or 0
        fill.BackgroundTransparency = status and 0.7 or 0
        lbl.TextColor3 = status and Theme.TextMuted or Theme.Text
        valLbl.TextColor3 = status and Theme.TextMuted or Theme.Accent
    end
    function ext:SetValue(val)
        for i, v in ipairs(valuesList) do
            if v == val then updateToPosition((i - 1) / (#valuesList - 1)) break end
        end
    end
    return ext
end

function Components.CreateToggle(parent, labelText, defaultState, callback)
