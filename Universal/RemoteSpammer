local Notification = {}

function Notification.Notify(title, desc, notifType)
    local col = Theme.Accent
    if notifType == "Success" then col = Theme.Success
    elseif notifType == "Warning" then col = Theme.Warning end

    local toast = Utils.Create("Frame", {
        Parent = NotifContainer, BackgroundColor3 = Theme.Panel, Size = UDim2.new(1, 0, 0, 55), BackgroundTransparency = 1
    }, {
        Utils.Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
        Utils.Create("UIStroke", { Color = col, Thickness = 1.5 }),
        Utils.Create("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, -15, 0, 22), Position = UDim2.new(0, 12, 0, 5), Text = title, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = col, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1 }),
        Utils.Create("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, -15, 0, 22), Position = UDim2.new(0, 12, 0, 25), Text = desc, Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTransparency = 1 })
    })

    Utils.Tween(toast, { BackgroundTransparency = 0 }, 0.2)
    for _, child in pairs(toast:GetChildren()) do
        if child:IsA("TextLabel") then Utils.Tween(child, { TextTransparency = 0 }, 0.2) end
    end

    task.delay(3, function()
        Utils.Tween(toast, { BackgroundTransparency = 1 }, 0.2)
        for _, child in pairs(toast:GetChildren()) do
            if child:IsA("TextLabel") then Utils.Tween(child, { TextTransparency = 1 }, 0.2) end
        end
        task.wait(0.2)
        toast:Destroy()
    end)
end

--====================================================
-- 7. WORKSPACE CLASS & INSTANCE MANAGER
--====================================================
local WorkspaceManager = {
    Workspaces = {},
    ActiveWorkspace = nil,
    TabCount = 0,
    PendingCloseWs = nil
}

local Workspace = {}
Workspace.__index = Workspace

function Workspace.new(id)
    local self = setmetatable({}, Workspace)
    self.Id = id
    self.Script = ""
    self.Threads = 1
    self.Delay = 0
    self.IsRunning = false
    self.StartTime = 0
    self.Runtime = 0
    self.TotalCalls = 0
    self.Status = "STOPPED"
    self.Logs = {}
    
    self.SpamThread = nil
    self.LastError = ""

    self:CreateTabUI()
    return self
end

function Workspace:CreateTabUI()
    self.TabUI = Utils.Create("Frame", {
        Name = "Tab_" .. self.Id,
        Size = UDim2.new(0, 85, 1, -4),
        BackgroundColor3 = Theme.TabStopped,
        BorderSizePixel = 0
    }, {
        Utils.Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
        Utils.Create("UIStroke", { Name = "ActiveStroke", Color = Theme.AccentGlow, Thickness = 1.5, Enabled = false }),
        Utils.Create("TextButton", {
            Name = "SelectBtn",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -22, 1, 0),
            Position = UDim2.new(0, 5, 0, 0),
            Text = "Workspace " .. self.Id,
            Font = Enum.Font.GothamSemibold,
            TextSize = 10,
            TextColor3 = Theme.Text
        }),
        Utils.Create("TextButton", {
            Name = "CloseBtn",
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 16, 0, 16),
            Position = UDim2.new(1, -18, 0.5, -8),
            Text = "×",
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = Theme.TextMuted
        })
    })

    self.TabUI.MouseEnter:Connect(function()
        if WorkspaceManager.ActiveWorkspace ~= self then
            Utils.Tween(self.TabUI, { BackgroundColor3 = self.TabUI.BackgroundColor3:Lerp(Color3.fromRGB(255,255,255), 0.1) }, 0.1)
        end
    end)
    self.TabUI.MouseLeave:Connect(function()
        self:UpdateVisual()
    end)

    self.TabUI.SelectBtn.Activated:Connect(function()
        WorkspaceManager.SwitchTab(self)
    end)

    self.TabUI.CloseBtn.Activated:Connect(function()
        WorkspaceManager.CloseTabTrigger(self)
    end)
end

function Workspace:UpdateVisual()
    if not self.TabUI then return end
    
    local isActive = (WorkspaceManager.ActiveWorkspace == self)
    self.TabUI.ActiveStroke.Enabled = isActive

    if self.Status == "RUNNING" then
        self.TabUI.BackgroundColor3 = Theme.TabRunning
    elseif self.Status == "ERROR" then
        self.TabUI.BackgroundColor3 = Theme.TabError
    else
        self.TabUI.BackgroundColor3 = isActive and Theme.Panel or Theme.TabStopped
    end
end

function Workspace:Log(text, logType)
    logType = logType or "INFO"
    local rawTime = os.date("%H:%M:%S")
    table.insert(self.Logs, { text = text, type = logType, time = rawTime })

    if #self.Logs > Config.MaxConsoleLogs then
        table.remove(self.Logs, 1)
    end

    if WorkspaceManager.ActiveWorkspace == self then
        WorkspaceManager.RenderLogItem(text, logType, rawTime)
    end
end

function Workspace:ClearLogs()
    self.Logs = {}
    if WorkspaceManager.ActiveWorkspace == self then
        for _, child in pairs(ConsoleFrame:GetChildren()) do
            if child:IsA("TextLabel") then child:Destroy() end
        end
        ConsoleFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    end
end

--====================================================
-- 8. EXECUTOR (CORE ALGORITHM - PARALLEL ISOLATION)
--====================================================
function Workspace:Start()
    if self.Script:gsub("%s+", "") == "" then
        Notification.Notify("Script Warning", "Workspace code cannot be empty!", "Warning")
        return
    end

    local compiledFunc, err = loadstring(self.Script)
    if not compiledFunc then
        self.Status = "ERROR"
        self:UpdateVisual()
        self:Log("Compilation Error: " .. tostring(err), "ERROR")
        Notification.Notify("Compilation Failed", "Workspace " .. self.Id .. " syntax error.", "Error")
        return
    end

    self.IsRunning = true
    self.Status = "RUNNING"
    self:UpdateVisual()
    
    self.StartTime = tick() - self.Runtime
    self:Log("Execution Started (Threads: " .. self.Threads .. " | Delay: " .. self.Delay .. "s)", "SUCCESS")

    self.SpamThread = task.spawn(function()
        while self.IsRunning do
            for i = 1, self.Threads do
                task.spawn(function()
                    local success, execErr = pcall(compiledFunc)
                    if success then
                        self.TotalCalls = self.TotalCalls + 1
                    else
                        if self.LastError ~= execErr then
                            self.LastError = tostring(execErr)
                            self:Log("Runtime Error: " .. self.LastError, "ERROR")
                            self.Status = "ERROR"
                            task.spawn(function() self:UpdateVisual() end)
                        end
                    end
                end)
            end

            if self.Delay <= 0 then
                RunService.Heartbeat:Wait()
            else
                task.wait(self.Delay)
            end
        end
    end)
end

function Workspace:Stop()
    self.IsRunning = false
    self.Status = "STOPPED"
    self:UpdateVisual()
    self:Log("Execution Stopped.", "WARN")
    self.SpamThread = nil
end

function Workspace:Destroy()
    self:Stop()
    if self.TabUI then
        self.TabUI:Destroy()
    end
end

--====================================================
-- 9. WORKSPACE MANAGER LOGIC
--====================================================
function WorkspaceManager.CreateTab()
    if WorkspaceManager.TabCount >= Config.MaxTabs then
        Notification.Notify("Limit Reached", "Max limit is 10 parallel workspaces.", "Error")
        return
    end

    local id = 1
    while WorkspaceManager.Workspaces[id] ~= nil do
        id = id + 1
    end

    local ws = Workspace.new(id)
    WorkspaceManager.Workspaces[id] = ws
    WorkspaceManager.TabCount = WorkspaceManager.TabCount + 1

    ws.TabUI.Parent = TabScrollingFrame
    TabScrollingFrame.CanvasSize = UDim2.new(0, TabScrollingFrame.UIListLayout.AbsoluteContentSize.X + 60, 1, 0)

    WorkspaceManager.SwitchTab(ws)
    ws:Log("Workspace Initialized.", "INFO")
end

function WorkspaceManager.SwitchTab(targetWs)
    if WorkspaceManager.ActiveWorkspace == targetWs then return end

    local prevWs = WorkspaceManager.ActiveWorkspace
    if prevWs then
        prevWs.Script = ScriptInput.Text
        prevWs.Threads = tonumber(ThreadsInput.Text) or 1
        prevWs.Delay = tonumber(DelayInput.Text) or 0
    end

    WorkspaceManager.ActiveWorkspace = targetWs

    if prevWs then prevWs:UpdateVisual() end
    targetWs:UpdateVisual()

    ScriptInput.Text = targetWs.Script
    ThreadsInput.Text = tostring(targetWs.Threads)
    DelayInput.Text = tostring(targetWs.Delay)

    for _, child in pairs(ConsoleFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end

    for _, logItem in ipairs(targetWs.Logs) do
        WorkspaceManager.RenderLogItem(logItem.text, logItem.type, logItem.time)
    end

    WorkspaceManager.UpdateActiveUI()
    Footer.Text = Config.Version .. " | Active Workspace: " .. targetWs.Id
end

function WorkspaceManager.CloseTabTrigger(ws)
    if ws.IsRunning then
        WorkspaceManager.PendingCloseWs = ws
        ConfirmOverlay.Visible = true
        Utils.Tween(ConfirmOverlay, { BackgroundTransparency = 0.4 }, 0.2)
    else
        WorkspaceManager.CloseTabDirect(ws)
    end
end

function WorkspaceManager.CloseTabDirect(ws)
    ws:Destroy()
    WorkspaceManager.Workspaces[ws.Id] = nil
    WorkspaceManager.TabCount = WorkspaceManager.TabCount - 1

    if WorkspaceManager.ActiveWorkspace == ws then
        local nextWs = nil
        for _, otherWs in pairs(WorkspaceManager.Workspaces) do
            nextWs = otherWs
            break
        end

        if nextWs then
            WorkspaceManager.SwitchTab(nextWs)
        else
            WorkspaceManager.ActiveWorkspace = nil
            WorkspaceManager.CreateTab()
        end
    end

    TabScrollingFrame.CanvasSize = UDim2.new(0, TabScrollingFrame.UIListLayout.AbsoluteContentSize.X + 60, 1, 0)
end

function WorkspaceManager.RenderLogItem(text, logType, logTime)
    local col = Theme.Text
    if logType == "ERROR" then col = Theme.Error
    elseif logType == "SUCCESS" then col = Theme.Success
    elseif logType == "WARN" then col = Theme.Warning end

    Utils.Create("TextLabel", {
        Parent = ConsoleFrame, BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 14),
        Text = string.format("[%s] %s", logTime, text),
        Font = Enum.Font.Code, TextSize = 10, TextColor3 = col, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true
    })

    ConsoleFrame.CanvasSize = UDim2.new(0, 0, 0, ConsoleFrame.UIListLayout.AbsoluteContentSize.Y + 10)
    ConsoleFrame.CanvasPosition = Vector2.new(0, ConsoleFrame.CanvasSize.Y.Offset)
end

function WorkspaceManager.UpdateActiveUI()
    local ws = WorkspaceManager.ActiveWorkspace
    if not ws then return end

    if ws.IsRunning then
        LblStatus.Text = "Status: RUNNING"
        LblStatus.TextColor3 = Theme.Success
        SpamBtn.Text = "STOP ATTACK"
        SpamBtn.BackgroundColor3 = Theme.Panel
        if not SpamBtn:FindFirstChild("BtnStroke") then
            Utils.Create("UIStroke", { Parent = SpamBtn, Color = Theme.Accent, Thickness = 1.5, Name = "BtnStroke" })
        end
    else
        LblStatus.Text = ws.Status == "ERROR" and "Status: ERROR" or "Status: STOPPED"
        LblStatus.TextColor3 = ws.Status == "ERROR" and Theme.Error or Theme.TextMuted
        SpamBtn.Text = "DEPLOY ALL TROOPS"
        SpamBtn.BackgroundColor3 = Theme.Accent
        if SpamBtn:FindFirstChild("BtnStroke") then SpamBtn.BtnStroke:Destroy() end
    end
end

