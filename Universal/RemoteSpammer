-- Fungsi Pop-Up Animation
local isPopupAnimating = false

local function showClosePopup()
    if isPopupAnimating then return end
    isPopupAnimating = true
    
    ModalOverlay.Visible = true
    ModalOverlay.BackgroundTransparency = 1
    
    PopupBox.Size = UDim2.new(0, 250, 0, 120)
    PopupBox.Position = UDim2.new(0.5, -125, 0.5, -60)
    
    TweenService:Create(ModalOverlay, TweenInfo.new(0.25), {BackgroundTransparency = 0.4}):Play()
    
    local popTween = TweenService:Create(PopupBox, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 310, 0, 150),
        Position = UDim2.new(0.5, -155, 0.5, -75)
    })
    popTween:Play()
    popTween.Completed:Connect(function()
        isPopupAnimating = false
    end)
end

local function hideClosePopup()
    if isPopupAnimating then return end
    isPopupAnimating = true
    
    TweenService:Create(ModalOverlay, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
    
    local popTween = TweenService:Create(PopupBox, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 250, 0, 120),
        Position = UDim2.new(0.5, -125, 0.5, -60)
    })
    popTween:Play()
    popTween.Completed:Connect(function()
        ModalOverlay.Visible = false
        isPopupAnimating = false
    end)
end

