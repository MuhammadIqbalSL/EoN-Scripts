end

--====================================================
-- 10. SYSTEM GLOBAL THREAD (UI REFRESHER)
--====================================================
task.spawn(function()
    while true do
        local ws = WorkspaceManager.ActiveWorkspace
        if ws then
            if ws.IsRunning then
                ws.Runtime = tick() - ws.StartTime
            end
            LblRuntime.Text = "Runtime: " .. Utils.FormatTime(ws.Runtime)
            LblCalls.Text = "Total Executed: " .. tostring(ws.TotalCalls)
            
            -- Terus-menerus memperbarui teks di status card
            WorkspaceManager.UpdateActiveUI()
        end
        task.wait(Config.UpdateRate)
    end
end)

