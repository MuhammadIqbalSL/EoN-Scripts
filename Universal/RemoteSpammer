            Utils.Tween(bg, { BackgroundColor3 = Theme.Background }, t)
            Utils.Tween(knob, { Position = UDim2.new(0, 3, 0.5, -7) }, t)
        end
    end
    updateVisual(true)

    bg.Activated:Connect(function()
        state = not state
        updateVisual(false)
        callback(state)
