-- Validasi TextBox Inputs (Hanya angka desimal dan bulat)
local function ValidateNumericBox(textBox, allowFloat)
    textBox:GetPropertyChangedSignal("Text"):Connect(function()
        if allowFloat then
            textBox.Text = textBox.Text:gsub("[^%d%.]", "") -- Filter non-angka dan non-titik
        else
            textBox.Text = textBox.Text:gsub("%D", "") -- Hanya angka bulat
        end
    end)
end
ValidateNumericBox(ThreadsInput, false)
ValidateNumericBox(DelayInput, true)

