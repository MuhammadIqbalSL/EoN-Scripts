-- 8. WORKSPACE TAB ARCHITECTURE OBJECTS
--====================================================
local WorkspaceManager = { Workspaces = {}, ActiveWorkspace = nil, TabCount = 0, PendingCloseWs = nil }
local Workspace = {}
Workspace.__index = Workspace

function Workspace.new(id)
    local self = setmetatable({}, Workspace)
    self.Id = id
    self.Script = ""
    self.Threads = 1
    self.Delay = 0
    self.IsRunning = false
    self.StartTime = 0
    self.Runtime = 0
    self.TotalCalls = 0
    self.Status = "STOPPED"
    self.Logs = {}
    self.SpamThread = nil
    self.LastError = ""
    self:CreateTabUI()
    return self
end

function Workspace:CreateTabUI()
    self.TabUI = Utils.Create("Frame", { Name = "Tab_" .. self.Id, Size = UDim2.new(0, 85, 1, -4), BackgroundColor3 = Theme.TabStopped, BorderSizePixel = 0 }, {
        Utils.Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
        Utils.Create("UIStroke", { Name = "ActiveStroke", Color = Theme.AccentGlow, Thickness = 1.5, Enabled = false }),
        Utils.Create("TextButton", { Name = "SelectBtn", BackgroundTransparency = 1, Size = UDim2.new(1, -22, 1, 0), Position = UDim2.new(0, 5, 0, 0), Text = "Tab " .. self.Id, Font = Enum.Font.GothamSemibold, TextSize = 10, TextColor3 = Theme.Text }),
        Utils.Create("TextButton", { Name = "CloseBtn", BackgroundTransparency = 1, Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(1, -18, 0.5, -8), Text = "×", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.TextMuted })
    })
    self.TabUI.SelectBtn.Activated:Connect(function() WorkspaceManager.SwitchTab(self) end)
    self.TabUI.CloseBtn.Activated:Connect(function() WorkspaceManager.CloseTabTrigger(self) end)
end

function Workspace:UpdateVisual()
    if not self.TabUI then return end
    local isActive = (WorkspaceManager.ActiveWorkspace == self)
    self.TabUI.ActiveStroke.Enabled = isActive
    if self.Status == "RUNNING" then self.TabUI.BackgroundColor3 = Theme.TabRunning
    elseif self.Status == "ERROR" then self.TabUI.BackgroundColor3 = Theme.TabError
    else self.TabUI.BackgroundColor3 = isActive and Theme.Panel or Theme.TabStopped end
    
    if SettingsState.CompactMode then
        self.TabUI.Size = UDim2.new(0, 75, 1, -2)
    else
        self.TabUI.Size = UDim2.new(0, 85, 1, -4)
    end
end

function Workspace:Log(text, logType)
    logType = logType or "INFO"
    local rawTime = os.date("%H:%M:%S")
    table.insert(self.Logs, { text = text, type = logType, time = rawTime })
    if #self.Logs > Config.MaxConsoleLogs then table.remove(self.Logs, 1) end
    if WorkspaceManager.ActiveWorkspace == self and AppState.CurrentView == "Workspace" then
        WorkspaceManager.RenderLogItem(text, logType, rawTime)
    end
end

function Workspace:Start()
    if self.Script:gsub("%s+", "") == "" then
        Notification.Notify("Script Warning", "Workspace code cannot be empty!", "Warning")
        return
    end
    local compiledFunc, err = loadstring(self.Script)
    if not compiledFunc then
        self.Status = "ERROR" self:UpdateVisual()
        self:Log("Compilation Error: " .. tostring(err), "ERROR")
        return
    end
    self.IsRunning = true self.Status = "RUNNING" self:UpdateVisual()
    self.StartTime = tick() - self.Runtime
    self:Log("Execution Deployed.", "SUCCESS")

    -- SYSTEM LOOP ALGORITMA INTI (TIDAK BERUBAH)
    self.SpamThread = task.spawn(function()
        while self.IsRunning do
            for i = 1, self.Threads do
                task.spawn(function()
                    local success, execErr = pcall(compiledFunc)
                    if success then self.TotalCalls = self.TotalCalls + 1
                    else
                        if self.LastError ~= execErr then
                            self.LastError = tostring(execErr)
                            self:Log("Runtime Error: " .. self.LastError, "ERROR")
                            self.Status = "ERROR" task.spawn(function() self:UpdateVisual() end)
                        end
                    end
                end)
            end
            if self.Delay <= 0 then RunService.Heartbeat:Wait() else task.wait(self.Delay) end
        end
    end)
end

function Workspace:Stop()
    self.IsRunning = false self.Status = "STOPPED" self:UpdateVisual()
    self:Log("Execution Paused.", "WARN")
    self.SpamThread = nil
end

function Workspace:Destroy() self:Stop() if self.TabUI then self.TabUI:Destroy() end end

