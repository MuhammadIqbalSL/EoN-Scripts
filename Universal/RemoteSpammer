-- Global Keyboard Input Binding Interceptor
local globalKeybindConn = UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == SettingsState.Keybinds.ToggleGui then
            if MainFrame.Visible then Minimize() else _G.RestoreMainWindow() end
        elseif input.KeyCode == SettingsState.Keybinds.OpenSettings then
            if AppState.CurrentView == "Workspace" then TransitionView(true) else TransitionView(false) end
        end
    end
end)
table.insert(AppState.Connections, globalKeybindConn)

-- Numeric Formats Sanitizer
local function SetupNumericSanitizer(box, isFloat)
    box:GetPropertyChangedSignal("Text"):Connect(function()
        box.Text = isFloat and box.Text:gsub("[^%d%.]", "") or box.Text:gsub("%D", "")
    end)
end
SetupNumericSanitizer(ThreadsInput, false)
SetupNumericSanitizer(DelayInput, true)

