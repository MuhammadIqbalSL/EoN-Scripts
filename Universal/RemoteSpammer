-- Animasi Navigasi (Main <-> Settings)
--------------------------------------------------------------------------------
local function switchToSettings()
    TitleLabel.Text = "Settings"
    BackBtn.Visible = true
    BackBtn.Position = UDim2.new(0, -75, 0, 7)
    
    -- Pergeseran Judul & Animasi Masuk Tombol Back
    TweenService:Create(TitleLabel, TweenInfo.new(0.3, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 95, 0, 0)
    }):Play()
    
    TweenService:Create(BackBtn, TweenInfo.new(0.3, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 12, 0, 7)
    }):Play()

    -- Pergeseran Halaman (Slide)
    TweenService:Create(MainPage, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(-1, -20, 0, 0)
    }):Play()
    
    TweenService:Create(SettingsPage, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()
end

local function switchToMain()
    TitleLabel.Text = "Main Menu"
    
    -- Kembalikan Judul & Animasi Keluar Tombol Back
    TweenService:Create(TitleLabel, TweenInfo.new(0.3, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 15, 0, 0)
    }):Play()
    
    local backTween = TweenService:Create(BackBtn, TweenInfo.new(0.25, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {
        Position = UDim2.new(0, -75, 0, 7)
    })
    backTween:Play()
    backTween.Completed:Connect(function()
        if TitleLabel.Text == "Main Menu" then
            BackBtn.Visible = false
        end
    end)

    -- Kembalikan Halaman
    TweenService:Create(MainPage, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()
    
    TweenService:Create(SettingsPage, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, 20, 0, 0)
    }):Play()
end

SettingsBtn.MouseButton1Click:Connect(switchToSettings)
BackBtn.MouseButton1Click:Connect(switchToMain)

