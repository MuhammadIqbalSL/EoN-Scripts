local SystemSettings = {}
local SliderGuiScale, SliderOpacity, SliderBlur, SliderAnimSpeed
local ToggleRainbow, ToggleCompact, ToggleFps
local PresetColorSelector, BindToggleGui, BindOpenSettings

-- Core Hardware Blur Integration
local BlurEffectInstance = Lighting:FindFirstChild("SpammerBlurEffect")
local isBlurSupported = pcall(function()
    if not BlurEffectInstance then
        BlurEffectInstance = Instance.new("BlurEffect")
        BlurEffectInstance.Name = "SpammerBlurEffect"
        BlurEffectInstance.Size = 0
        BlurEffectInstance.Parent = Lighting
    end
end)

function SystemSettings.ApplySettings(key, value)
    SettingsState[key] = value
    
    if key == "GuiScale" then
        MainFrame.GlobalScale.Scale = value
    elseif key == "BackgroundOpacity" then
        local transparency = value / 100
        MainFrame.BackgroundTransparency = transparency
        Header.BackgroundTransparency = transparency
        SettingsView.BackgroundTransparency = transparency
    elseif key == "BorderColor" then
        if not SettingsState.RainbowBorder then
            MainFrame.WindowBorder.Color = value
        end
    elseif key == "UiBlur" then
        if isBlurSupported and BlurEffectInstance then
            BlurEffectInstance.Size = (value / 100) * 24
        end
    elseif key == "CompactMode" then
        if value then
            TabBarFrame.Size = UDim2.new(1, 0, 0, 26)
            Body.Size = UDim2.new(1, -20, 1, -90)
            Body.Position = UDim2.new(0, 10, 0, 75)
            ScriptInput.Size = UDim2.new(1, 0, 1, -30)
            ConfigContainer.Size = UDim2.new(1, 0, 0, 25)
            ConfigContainer.Position = UDim2.new(0, 0, 1, -25)
        else
            TabBarFrame.Size = UDim2.new(1, 0, 0, 35)
            Body.Size = UDim2.new(1, -20, 1, -105)
            Body.Position = UDim2.new(0, 10, 0, 85)
            ScriptInput.Size = UDim2.new(1, 0, 1, -45)
            ConfigContainer.Size = UDim2.new(1, 0, 0, 35)
            ConfigContainer.Position = UDim2.new(0, 0, 1, -35)
        end
        for _, ws in pairs(WorkspaceManager.Workspaces) do ws:UpdateVisual() end
    elseif key == "BoostFpsMode" then
        if value then
            ToggleRainbow:SetState(false) SettingsState.RainbowBorder = false
            MainFrame.WindowBorder.Color = SettingsState.BorderColor
            Config.UpdateRate = 0.5
        else
            Config.UpdateRate = 0.1
        end
    end
end

function SystemSettings.Initialize()
    -- Category: Appearance
    Components.CreateCategory(SettingsScroll, "Appearance")
    SliderGuiScale = Components.CreateSlider(SettingsScroll, "GUI Scale", {0.8, 0.9, 1.0, 1.1, 1.25, 1.5}, SettingsState.GuiScale, function(v) SystemSettings.ApplySettings("GuiScale", v) end)
    SliderOpacity = Components.CreateSlider(SettingsScroll, "Background Opacity", {0, 20, 40, 60, 80, 100}, SettingsState.BackgroundOpacity, function(v) SystemSettings.ApplySettings("BackgroundOpacity", v) end)
    
    PresetColorSelector = Components.CreatePresetSelector(SettingsScroll, "Border Color Preset", SettingsState.BorderColor, function(v) SystemSettings.ApplySettings("BorderColor", v) end)
    ToggleRainbow = Components.CreateToggle(SettingsScroll, "Rainbow Border Effect", SettingsState.RainbowBorder, function(v) 
        SystemSettings.ApplySettings("RainbowBorder", v)
    end)
    
    SliderBlur = Components.CreateSlider(SettingsScroll, "UI Screen Blur Strength", {0, 20, 40, 60, 80, 100}, SettingsState.UiBlur, function(v) SystemSettings.ApplySettings("UiBlur", v) end)
    if not isBlurSupported then SliderBlur:SetDisabled(true) end

    -- Category: Animation
    Components.CreateCategory(SettingsScroll, "Animation")
    SliderAnimSpeed = Components.CreateSlider(SettingsScroll, "System Animation Speed", {"Slow", "Normal", "Fast"}, SettingsState.AnimationSpeed, function(v) SystemSettings.ApplySettings("AnimationSpeed", v) end)

    -- Category: Behavior & Optimization
    Components.CreateCategory(SettingsScroll, "Behavior")
    ToggleCompact = Components.CreateToggle(SettingsScroll, "Compact Interface Mode", SettingsState.CompactMode, function(v) SystemSettings.ApplySettings("CompactMode", v) end)
    ToggleFps = Components.CreateToggle(SettingsScroll, "Boost FPS Optimization", SettingsState.BoostFpsMode, function(v) SystemSettings.ApplySettings("BoostFpsMode", v) end)

    -- Category: Controls Keybind
    Components.CreateCategory(SettingsScroll, "Controls Keybind")
    BindToggleGui = Components.CreateKeybindButton(SettingsScroll, "Show / Hide Jendela GUI", SettingsState.Keybinds.ToggleGui, function(v) SettingsState.Keybinds.ToggleGui = v end)
    BindOpenSettings = Components.CreateKeybindButton(SettingsScroll, "Open Settings View Panel", SettingsState.Keybinds.OpenSettings, function(v) SettingsState.Keybinds.OpenSettings = v end)

    -- Factory Reset Buttons
    local resetBtn = Utils.Create("TextButton", { Parent = SettingsScroll, BackgroundColor3 = Theme.Panel, Size = UDim2.new(1, 0, 0, 35), Text = "Reset Settings to Factory Defaults", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.Error }, {
        Utils.Create("UICorner", { CornerRadius = UDim.new(0, 6) }), Utils.Create("UIStroke", { Color = Theme.Border, Thickness = 1 })
    })
    resetBtn.Activated:Connect(function()
        _G.ShowGlobalDialog("Reset all system adjustments to factory defaults?", function()
            for k, v in pairs(DefaultSettings) do SettingsState[k] = v end
            
            -- Sync Visual Slider Elements
            SliderGuiScale:SetValue(SettingsState.GuiScale)
            SliderOpacity:SetValue(SettingsState.BackgroundOpacity)
            SliderBlur:SetValue(SettingsState.UiBlur)
            SliderAnimSpeed:SetValue(SettingsState.AnimationSpeed)
            ToggleRainbow:SetState(SettingsState.RainbowBorder)
            ToggleCompact:SetState(SettingsState.CompactMode)
            ToggleFps:SetState(SettingsState.BoostFpsMode)
            BindToggleGui:SetKey(SettingsState.Keybinds.ToggleGui)
            BindOpenSettings:SetKey(SettingsState.Keybinds.OpenSettings)
            
            -- Apply Global Modifications
            for k, v in pairs(SettingsState) do SystemSettings.ApplySettings(k, v) end
            Notification.Notify("Factory Reset", "Settings have been reset to default values.", "Warning")
        end)
    end)
    
    -- Rainbow Border Logic Runner
    local hue = 0
    local rainbowConn = RunService.Heartbeat:Connect(function(dt)
        if SettingsState.RainbowBorder and not SettingsState.BoostFpsMode then
            hue = (hue + (dt * 0.05)) % 1
            MainFrame.WindowBorder.Color = Color3.fromHSV(hue, 0.8, 0.9)
        end
    end)
    table.insert(AppState.Connections, rainbowConn)
end

