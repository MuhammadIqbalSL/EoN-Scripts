        Utils.Create("UICorner", { CornerRadius = UDim.new(1, 0) }), Utils.Create("UIStroke", { Color = Theme.Border, Thickness = 1 })
    })
    local knob = Utils.Create("Frame", { Parent = bg, Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Theme.Text }, { Utils.Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

    local state = defaultState
    local function updateVisual(instant)
        local t = instant and 0 or Utils.GetTweenDuration()
        if state then
            Utils.Tween(bg, { BackgroundColor3 = Theme.Accent }, t)
            Utils.Tween(knob, { Position = UDim2.new(1, -17, 0.5, -7) }, t)
