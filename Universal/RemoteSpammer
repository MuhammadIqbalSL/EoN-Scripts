function _G.RestoreMainWindow()
    FloatBtn.Visible = false
    MainFrame.Visible = true
    Utils.Tween(MainFrame, { Size = UDim2.new(0, 600, 0, 420), Position = UDim2.new(0.5, -300, 0.5, -210) }, 0.2)
end

local function MasterShutdown()
    -- 1. Hentikan Seluruh Workspace Core Loop Threads
    for _, ws in pairs(WorkspaceManager.Workspaces) do ws:Stop() ws:Destroy() end
    -- 2. Bersihkan Seluruh Event Connections Listener
    for _, conn in pairs(AppState.Connections) do conn:Disconnect() end
    -- 3. Batalkan Seluruh Animasi Tweens Aktif
    for _, tw in pairs(AppState.ActiveTweens) do tw:Cancel() end
    -- 4. Kembalikan Efek Kamera Pencahayaan
    if BlurEffectInstance then BlurEffectInstance:Destroy() end
    
    -- 5. Hancurkan Element Sisa Interface Core Visual
    GUI:Destroy()
end

