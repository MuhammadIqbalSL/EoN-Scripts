-- Reusable Custom Slider Component
local Slider = {}
Slider.__index = Slider

function Slider.new(parent, config)
    local self = setmetatable({}, Slider)
    self.Min = config.Min or 0
    self.Max = config.Max or 100
    self.Value = config.Default or self.Min
    self.Callback = config.Callback or function() end
    self.IsHSV = config.IsHSV or false

    self.Frame = Utils.Create("Frame", {
        Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 45)
    })

    self.TitleLabel = Utils.Create("TextLabel", {
        Parent = self.Frame, BackgroundTransparency = 1, Size = UDim2.new(0.7, 0, 0, 18),
        Text = config.Title or "Slider", Font = Enum.Font.GothamSemibold, TextSize = 10,
        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left
    })

    self.ValueLabel = Utils.Create("TextLabel", {
        Parent = self.Frame, BackgroundTransparency = 1, Size = UDim2.new(0.3, 0, 0, 18),
        Position = UDim2.new(0.7, 0, 0, 0), Text = tostring(math.floor(self.Value)),
        Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = Theme.TextMuted,
        TextXAlignment = Enum.TextXAlignment.Right
    })

    -- Track container tersendiri
    self.Track = Utils.Create("Frame", {
        Parent = self.Frame, BackgroundColor3 = Theme.Background,
        Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 0, 24),
        ClipsDescendants = false
    }, {
        Utils.Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
        Utils.Create("UIStroke", { Color = Theme.Border, Thickness = 1 })
    })

    if self.IsHSV then
        -- Multi-color bar visual khusus Color Slider
        Utils.Create("UIGradient", {
            Parent = self.Track,
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
                ColorSequenceKeypoint.new(0.16, Color3.fromHSV(0.16, 1, 1)),
                ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
                ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
                ColorSequenceKeypoint.new(0.66, Color3.fromHSV(0.66, 1, 1)),
                ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1))
            })
        })
    end

    self.Fill = Utils.Create("Frame", {
        Parent = self.Track, BackgroundColor3 = self.IsHSV and Color3.fromRGB(255, 255, 255) or Theme.Accent,
        Size = UDim2.new(0, 0, 1, 0), BackgroundTransparency = self.IsHSV and 0.6 or 0
    }, {
        Utils.Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
        Utils.Create("UIStroke", { Color = Theme.Border, Thickness = 1 })
    })

    -- Thumb yang warnanya selaras dengan background slider
    self.Thumb = Utils.Create("Frame", {
        Parent = self.Track, BackgroundColor3 = Theme.Background,
        Size = UDim2.new(0, 16, 0, 16), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), ZIndex = 3
    }, {
        Utils.Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
        Utils.Create("UIStroke", { Color = Theme.Border, Thickness = 1.5 })
    })

    self:InitDrag()
    self:SetValue(self.Value)
    return self
end

function Slider:SetValue(val)
    self.Value = math.clamp(val, self.Min, self.Max)
    local alpha = (self.Value - self.Min) / (self.Max - self.Min)
    
    self.Fill.Size = UDim2.new(alpha, 0, 1, 0)
    self.Thumb.Position = UDim2.new(alpha, 0, 0.5, 0)
    
    if self.IsHSV then
        self.ValueLabel.Text = string.format("%d°", math.floor(self.Value * 360))
    else
        self.ValueLabel.Text = tostring(math.floor(self.Value))
    end

    self.Callback(self.Value)
end

function Slider:InitDrag()
    local dragging = false

    local function UpdateInput(input)
        local trackAbsPos = self.Track.AbsolutePosition.X
        local trackAbsSize = self.Track.AbsoluteSize.X
        local mousePos = input.Position.X
        local alpha = math.clamp((mousePos - trackAbsPos) / trackAbsSize, 0, 1)
        local value = self.Min + (alpha * (self.Max - self.Min))
        self:SetValue(value)
    end

    self.Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

